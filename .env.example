# Example environment variables for QA Toolkit.
# Copy to .env and fill in values for your project.

# ── Target website (for Playwright tests & browser-test.js) ──
QA_BASE_URL=https://example.com

# ── Target API (for api-health.spec.ts & base_api_client.py) ──
QA_API_BASE_URL=https://api.example.com

# ── Defaults ──
QA_COUNTRY_CODE=
QA_TIMEOUT_MS=30000
QA_MAX_WORKERS=10
QA_OUTPUT_DIR=./reports
QA_AUDITOR=Azeez
QA_VERBOSE=false
