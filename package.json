{
  "name": "qa-toolkit",
  "version": "2.0.0",
  "description": "Universal QA & Data Engineering Toolkit — browser testing, Playwright specs, API testing, accessibility audits, visual regression, Excel ETL, web scraping, report generation, and data validation",
  "author": "Azeez",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test specs/api-health.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:browser": "node browser-test.js",
    "test:search": "node web-search.js",
    "test:a11y": "node accessibility-check.js",
    "report": "node report-generator.js",
    "report:show": "playwright show-report",
    "diff": "node visual-diff.js",
    "fetch": "node url-fetch.js",
    "scrape": "node web-scraper.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.52.0",
    "@axe-core/playwright": "^4.10.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
